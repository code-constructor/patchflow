<% content_for :title, "New review · Patchflow" %>
<div class="narrow">
  <div class="breadcrumb"><%= link_to "← #{current_repository.name}", root_path %></div>
  <section class="card">
    <div class="eyebrow">New review artifact</div>
    <h2>Choose committed source refs</h2>
    <p class="muted">Patchflow resolves both refs to exact SHAs and reviews the target from their merge base.</p>

    <%= form_with url: reviews_path, class: "stack" do |form| %>
      <div class="grid-two">
        <%= form.label :base_ref do %>
          Base ref
          <%= form.text_field :base_ref, value: @base_ref, required: true, autocomplete: "off" %>
        <% end %>
        <%= form.label :target_ref do %>
          Target ref
          <%= form.text_field :target_ref, value: @target_ref, required: true, autocomplete: "off" %>
        <% end %>
      </div>
      <div class="button-row">
        <%= form.submit "Create review", class: "button" %>
        <%= link_to "Cancel", root_path, class: "button button--quiet" %>
      </div>
    <% end %>
  </section>
</div>
