<% content_for :title, "#{@step.fetch('title')} · Patchflow" %>
<div class="breadcrumb"><%= link_to "← Review overview", review_path(@artifact.id) %></div>

<section class="row row--between">
  <div>
    <div class="eyebrow">Step <%= @step_index + 1 %> of <%= @artifact.steps.length %></div>
    <h2><%= @step.fetch("title") %></h2>
    <p class="lede"><%= @step.fetch("rationale") %></p>
  </div>
  <span class="priority priority--<%= @step.fetch('priority') %>"><%= @step.fetch("priority") %> priority</span>
</section>

<% @step.fetch("files").each do |path| %>
  <% diff = @diffs[path] %>
  <section class="section card">
    <h3><%= path %></h3>

    <% annotations_for(@artifact, scope: "file", file_path: path).each do |annotation| %>
      <div class="annotation section"><span class="small muted">File note</span><p><%= annotation.fetch("body") %></p></div>
    <% end %>
    <% annotations_for(@artifact, scope: "line", file_path: path).each do |annotation| %>
      <div class="annotation section">
        <span class="small muted"><%= annotation.fetch("side") %> line <%= annotation.fetch("start_line") %><%= "–#{annotation['end_line']}" if annotation["end_line"] && annotation["end_line"] != annotation["start_line"] %></span>
        <p><%= annotation.fetch("body") %></p>
      </div>
    <% end %>

    <% if @diff_errors[path] %>
      <div class="diff-notice">
        <strong>Diff not displayed</strong>
        <p><%= @diff_errors.fetch(path) %>. Review this generated or unusually large file directly in the repository.</p>
      </div>
    <% else %>
      <div class="diff-viewer"
           data-controller="diff-viewer"
           data-diff-viewer-highlights-value="<%= @diff_highlights.fetch(path).to_json %>">
        <div class="diff-toolbar" aria-label="Diff layout">
          <button type="button" class="diff-mode-button" data-diff-viewer-target="splitButton" data-action="diff-viewer#showSplit">Split</button>
          <button type="button" class="diff-mode-button" data-diff-viewer-target="unifiedButton" data-action="diff-viewer#showUnified">Unified</button>
        </div>
        <pre hidden data-diff-viewer-target="source"><%= diff %></pre>
        <div class="diff-render" data-diff-viewer-target="output"></div>
        <noscript><pre class="diff"><%= diff.presence || "No textual diff available for this path." %></pre></noscript>
      </div>
    <% end %>

    <%= form_with url: review_annotations_path(@artifact.id), class: "stack annotation-form" do |form| %>
      <%= form.hidden_field :step_id, value: @step.fetch("id") %>
      <%= form.hidden_field "annotation[file_path]", value: path %>
      <div class="line-fields">
        <%= form.label "annotation[scope]" do %>
          Annotation type
          <%= form.select "annotation[scope]", [["File", "file"], ["Line or range", "line"]] %>
        <% end %>
        <%= form.label "annotation[side]" do %>
          Diff side
          <%= form.select "annotation[side]", [["Target", "target"], ["Base", "base"]], include_blank: "Not a line note" %>
        <% end %>
        <%= form.label "annotation[start_line]" do %>
          Start line
          <%= form.number_field "annotation[start_line]", min: 1 %>
        <% end %>
      </div>
      <%= form.label "annotation[end_line]" do %>
        End line (optional)
        <%= form.number_field "annotation[end_line]", min: 1 %>
      <% end %>
      <%= form.label "annotation[body]" do %>
        Note
        <%= form.text_area "annotation[body]", required: true %>
      <% end %>
      <div><%= form.submit "Save annotation", class: "button button--small" %></div>
    <% end %>
  </section>
<% end %>

<nav class="step-nav">
  <div><%= link_to "← #{@previous_step.fetch('title')}", review_step_path(@artifact.id, @previous_step.fetch("id")), class: "button button--quiet" if @previous_step %></div>
  <div><%= link_to "#{@next_step.fetch('title')} →", review_step_path(@artifact.id, @next_step.fetch("id")), class: "button" if @next_step %></div>
</nav>
