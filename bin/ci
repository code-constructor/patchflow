#!/usr/bin/env bash
set -euo pipefail

export GOFLAGS="${GOFLAGS:+${GOFLAGS} }-mod=mod"

unformatted="$(gofmt -l schema internal cmd)"
if [[ -n "${unformatted}" ]]; then
  echo "Go files need formatting:"
  echo "${unformatted}"
  exit 1
fi

go vet ./...
go test ./...
go build -trimpath ./cmd/patchflow
