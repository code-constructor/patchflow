# syntax=docker/dockerfile:1

FROM golang:1.24-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN GOFLAGS=-mod=mod CGO_ENABLED=0 go build -trimpath -o /patchflow ./cmd/patchflow

FROM debian:bookworm-slim
ARG USER_ID=1000
ARG GROUP_ID=1000

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y ca-certificates curl git && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd --gid "${GROUP_ID}" patchflow && \
    useradd --uid "${USER_ID}" --gid "${GROUP_ID}" --create-home patchflow

COPY --from=build /patchflow /usr/local/bin/patchflow
USER patchflow
WORKDIR /workspace
EXPOSE 3000
CMD ["patchflow", "serve", "--addr", "0.0.0.0:3000"]
