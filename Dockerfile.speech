# syntax=docker/dockerfile:1

FROM rocm/pytorch:rocm7.2.4_ubuntu24.04_py3.12_pytorch_release_2.9.1

# This pinned upstream PR adds the chunk iterator used for real audio streaming.
ARG CHATTERBOX_REVISION=ce5a900dbdbc776eeb3d00c1c1607143c7604a5b

RUN pip install --no-cache-dir --no-deps "chatterbox-tts @ git+https://github.com/chrishayen/chatterbox.git@${CHATTERBOX_REVISION}" && \
    pip install --no-cache-dir \
      "setuptools==80.9.0" \
      "numpy==1.26.4" \
      "librosa==0.11.0" \
      "s3tokenizer" \
      "transformers==5.2.0" \
      "diffusers==0.29.0" \
      "resemble-perth>=1.0.0" \
      "conformer==0.3.2" \
      "safetensors==0.5.3" \
      "spacy-pkuseg" \
      "pykakasi==2.3.0" \
      "pyloudnorm" \
      "omegaconf"

WORKDIR /app
COPY speech/chatterbox_server.py /app/chatterbox_server.py

ENV HF_HOME=/models/huggingface \
    PATCHFLOW_TTS_VOICE_PATH=/models/voice/reference.wav \
    PATCHFLOW_TTS_DEVICE=cpu \
    TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL=1

EXPOSE 5000
ENTRYPOINT ["python3", "/app/chatterbox_server.py"]
