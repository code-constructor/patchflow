# syntax=docker/dockerfile:1

FROM python:3.12-slim

ARG PIPER_VERSION=1.6.0
ARG PIPER_VOICE=en_US-lessac-high

RUN pip install --no-cache-dir "piper-tts[http]==${PIPER_VERSION}" && \
    mkdir -p /data && \
    python3 -m piper.download_voices --data-dir /data "${PIPER_VOICE}"

USER 65532:65532
EXPOSE 5000
ENTRYPOINT ["python3", "-m", "piper.http_server", "--host", "0.0.0.0", "--data-dir", "/data"]
CMD ["-m", "en_US-lessac-high"]
