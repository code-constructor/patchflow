# Copy to .env; Docker Compose reads it automatically. Every value is optional.

# Host directory that the container mounts at /workspace and that the
# repository picker may browse.
PATCHFLOW_PROJECTS_PATH=${HOME}/Projects

# Address and port published on the host.
PATCHFLOW_BIND=127.0.0.1
PATCHFLOW_PORT=3000

# Owner of created review artifacts inside the container.
PATCHFLOW_UID=1000
PATCHFLOW_GID=1000

# Git configuration providing the reviewer name for comments.
PATCHFLOW_GIT_CONFIG_PATH=${HOME}/.config/git/config

# Location of the shared settings file inside the container.
PATCHFLOW_DOCKER_CONFIG_PATH=/workspace/.patchflow/config.json

# --- Optional local speech stack ---------------------------------------------
